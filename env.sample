# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
COLLECTION_NAME=looyer

# Embeddings
EMBED_API_BASE=
EMBED_MODEL_NAME=bge-m3
EMBED_API_KEY=

# Reranker
RERANKED_LLM_MODEL=./.cache/hf/<path-to-bge-reranker>

# LLM answer
ANSWER_API_BASE=http://127.0.0.1:8080/v1
ANSWER_MODEL_NAME=phi-4-reasoning
ANSWER_API_KEY=

# LLM hyde
HYDE_API_BASE=http://127.0.0.1:8081/v1
HYDE_MODEL_NAME=qwen3-4b-instruct
HYDE_API_KEY=

# Paths
HF_CACHE_DIR=./.cache/hf
PIPELINE_CACHE_DIR=./.cache/pipeline
DOCLING_ARTIFACTS_PATH=.cache/models

# Docker Compose
HOST_QDRANT_DIR=/absolute/path/to/looyer/data/qdrant
HOST_HF_CACHE_DIR=/absolute/path/to/looyer/.cache/hf
HOST_LLM_CONFIG_DIR=/absolute/path/to/looyer/llm-server
HOST_OLLAMA_DIR=/absolute/path/to/looyer/.cache/ollama
LLM_THREADS=8

# Legacy
LLM_MODEL=./.cache/hf/<path-to-gguf>
INDEX_DIR=./data/chroma
