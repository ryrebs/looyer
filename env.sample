# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
COLLECTION_NAME=looyer

# Embeddings
EMBED_API_BASE=
EMBED_MODEL_NAME=bge-m3
EMBED_API_KEY=

# Reranker
RERANKED_LLM_MODEL=./.cache/hf/<path-to-bge-reranker>
## Required. Raw reranker score (can be negative) below which a chunk is dropped.
## -5 is loose (drops almost nothing); replace it with a value measured from best_rerank_score.
RERANK_SCORE_THRESHOLD=-5

# LLM answer
ANSWER_API_BASE=http://127.0.0.1:8080/v1
ANSWER_MODEL_NAME=phi-4-reasoning
ANSWER_API_KEY=

# LLM hyde
HYDE_API_BASE=http://127.0.0.1:8081/v1
HYDE_MODEL_NAME=qwen3-4b-instruct
HYDE_API_KEY=

## Judge role (evaluation only): grades generated answers YES/NO. Use a different model from
## the answer role, since a model tends to approve its own answers. Temperature 0 (profiles.json).
JUDGE_API_BASE=https://ollama.com/v1
JUDGE_MODEL_NAME=nemotron-3-super
JUDGE_API_KEY=

# MLflow (local tracing and run comparison)
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_TRACKING_URI=sqlite:///.cache/mlflow/mlflow.db

# Paths
HF_CACHE_DIR=./.cache/hf
PIPELINE_CACHE_DIR=./.cache/pipeline
DOCLING_ARTIFACTS_PATH=.cache/models

# Docker Compose
HOST_QDRANT_DIR=/absolute/path/to/looyer/data/qdrant
HOST_HF_CACHE_DIR=/absolute/path/to/looyer/.cache/hf
HOST_LLM_CONFIG_DIR=/absolute/path/to/looyer/llm-server
HOST_OLLAMA_DIR=/absolute/path/to/looyer/.cache/ollama
LLM_THREADS=8

# TO BE DEPRECATED: LLM_MODEL (only test_model.py, in-process llama.cpp), INDEX_DIR (Chroma)
LLM_MODEL=./.cache/hf/<path-to-gguf>
INDEX_DIR=./data/chroma
