[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# --- Layer 0: model seam ---
pydantic = "==2.14.2"                         # LLMTextCompletionProgram validates structured output
# --- Layer 1: document loading ---
llama-index-core = "==0.14.25"                   # chunking, pipeline, retrieval, structured output
docling = "==2.147.0"                            # HTML → Markdown (Constitution)
pymupdf4llm = "==1.28.2"                        # PDF → Markdown (Civil Code)
# --- Layer 3: embedding + vector index ---
llama-index-embeddings-ollama = "==0.10.0"      # bge-m3 via Ollama native API
# TO BE DEPRECATED (Chroma, replaced by Qdrant): remove both lines once the Chroma code is gone
chromadb = "==1.5.9"                           # embedded vector store, no server
llama-index-vector-stores-chroma = "==0.6.0"   # LlamaIndex ↔ Chroma bridge
llama-index-llms-ollama = "==0.11.0"            # Ollama LLM — reasoning via native Ollama API
# --- Layer 7: orchestration + API ---
fastapi = "==0.162.0"
uvicorn = {extras = ["standard"], version = "==0.54.0"}
flask = "==3.1.3"
llama-index-postprocessor-flag-embedding-reranker = "==0.6.0"
flagembedding = "==1.4.2"                # required by the reranker, not pulled in by it
llama-index-embeddings-huggingface = "==0.8.0"
optimum = {extras = ["onnxruntime"], version = "==2.1.0"}
optimum-intel = {extras = ["openvino"], version = "==1.27.0"}
llama-index-llms-openai-like = "==0.8.1"      # LLMs via any OpenAI-compatible server (llama-server, vLLM, hosted)
llama-index-llms-llama-cpp = "==0.7.0"
# --- Need  libopenblas-dev on debian
# --- CMAKE_ARGS="-DGGML_BLAS=ON -DGGML_BLAS_VENDOR=OpenBLAS" pipenv run pip install llama-cpp-python --force-reinstall --no-cache-dir
llama-cpp-python = "==0.3.36"
huggingface-hub = "==0.36.2"
llama-index-retrievers-bm25 = "==0.8.0"
llama-index-vector-stores-qdrant = "==0.10.4"
qdrant-client = "==1.18.0"                # must match the Qdrant server (1.18.x), see README
graphifyy = "==0.9.102"

[dev-packages]
pytest = "==9.2.0"
# pre-commit installs isort, black and bandit in its own envs; pylint runs in this env (local hook)
pre-commit = "==4.7.0"
pylint = "==4.1.3"

[requires]
python_version = "3.11"

[scripts]
start = "python ./main.py"
test = "python -m pytest"

[pipenv]
allow_prereleases = true
